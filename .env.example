# ============================================================
# ENVIRONMENT VARIABLES — EXAMPLE
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Database (PostgreSQL via Prisma) ----------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ---- Sanity CMS --------------------------------------------
SANITY_PROJECT_ID="your-sanity-project-id"
SANITY_DATASET="production"
SANITY_API_VERSION="2024-01-01"
SANITY_API_TOKEN="your-sanity-api-token"
# Public (safe to expose): used for read-only queries in the browser
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# ---- Cloudflare Turnstile ----------------------------------
# Secret key: server-side only (NEVER use NEXT_PUBLIC_ for this)
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
# Site key: used in the browser widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# ---- Rate Limiting -----------------------------------------
# Upstash Redis URL for rate limiting (optional; falls back to in-memory)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ---- Email / SMTP (inquiry notifications) ------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@frontiersystems.example"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Frontier Systems <no-reply@frontiersystems.example>"
INQUIRY_RECIPIENT_EMAIL="inquiries@frontiersystems.example"

# ---- Application -------------------------------------------
# Must match your actual deployment URL — no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3002"
# Node environment: development | test | production
NODE_ENV="development"

# ---- Analytics (optional) ----------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ---- Cloudinary (Secure Private Document Storage) ----------
# Optional: falls back to isolated private disk storage if omitted
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
